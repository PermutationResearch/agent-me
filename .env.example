# Copy to .env. Never commit real credentials.
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=5173
# Leave blank for the same-origin Vite/Nginx proxy. Set an origin only when the
# browser must call an independently hosted API.
VITE_API_BASE_URL=

APP_NAME=Agent-Me
APP_DESCRIPTION=Build, inspect, and evaluate auditable role-based multi-agent RAG workflows.
KNOWLEDGE_DIR=knowledge
MAX_QUESTION_CHARS=8000
MAX_CONTEXT_CHARS=12000
# Per-file limit, followed by whole-corpus document-count and byte limits.
MAX_DOCUMENT_BYTES=1000000
MAX_KNOWLEDGE_DOCUMENTS=256
MAX_KNOWLEDGE_BYTES=16000000
MAX_HISTORY_CHARS=24000
MAX_ANSWER_CHARS=50000
# Complete decoded upstream HTTP response limit; enforced before JSON parsing.
MAX_PROVIDER_RESPONSE_BYTES=2000000
MAX_REQUEST_BODY_BYTES=262144
PROVIDER_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible inference provider. Leave blank for extractive local mode.
# OrcaRouter example:
#   LLM_BASE_URL=https://api.orcarouter.ai/v1
#   LLM_MODEL=orcarouter/auto
# Create a key through the Agent-Me partner link:
#   https://www.orcarouter.ai/ref/ref_a8d28bcd0c266af4ae1c
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Comma-separated browser origins in production.
CORS_ORIGINS=http://localhost:5173

# Optional local private workspace: run python3 scripts/init_personal.py.
# Load private/personal.env explicitly with uvicorn --env-file.
# Do not enable personal mode on a public deployment.
# Optional verified external semantic corpus. Keep it outside the repository,
# mode 0600, and use an owner-only index. Search results are review-only.
PERSONAL_CORPUS_INDEX=
PERSONAL_CORPUS_SHA256=
PERSONAL_CORPUS_RESULT_LIMIT=10
PERSONAL_CORPUS_EXCERPT_CHARS=640

# Include archived generated work and cite it in private chat (opt-in).
PERSONAL_CORPUS_INCLUDE_WORK=false
PERSONAL_CORPUS_CHAT_ENABLED=false

# Optional private GEPA optimizer (backend optimize extra; separate from chat model).
OPTIMIZATION_OLLAMA_URL=http://127.0.0.1:11434
OPTIMIZATION_MODEL=qwen2.5:7b
# Blank uses PERSONAL_DATA_DIR/optimization; an encrypted vault path is supported.
PERSONAL_OPTIMIZATION_DIR=

# Separate trace intake and buyer review. Disabled unless explicitly configured.
# scripts/start_trace_market.py creates a local private configuration and buyer key.
TRACE_SUBMISSIONS_ENABLED=false
TRACE_SUBMISSION_DATA_DIR=private/trace-market/data
TRACE_BUYER_TOKEN=
TRACE_SUBMISSION_MAX_BYTES=26214400
MAX_TRACE_SUBMISSION_BODY_BYTES=27262976
TRACE_SUBMISSION_STORAGE_LIMIT_BYTES=536870912
# Vite development proxy (server-side only; never put a buyer token in VITE_*).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Self-hosted public intake only: never combine with PERSONAL_ENABLED=true.
TRACE_MARKET_PUBLIC=false
# Production frontend hides the private example workspace.
VITE_PUBLIC_MARKET=false

# Optional local stdio MCP (client/server environment; see docs/MCP.md)
# AGENT_ME_MCP_DATA_DIR=/absolute/private/path/agent-me-mcp
# AGENT_ME_REVIEW_URL=http://127.0.0.1:8001
# AGENT_ME_OPTIMIZATION_PYTHON=/absolute/path/to/agent-me/backend/.venv/bin/python
# AGENT_ME_OLLAMA_URL=http://127.0.0.1:11434
# AGENT_ME_RATE_CARD=/absolute/path/to/agent-me/mcp/rate-card.json

# Optional free remote GEPA; explicit consent + export checksum still required
# AGENT_ME_OPTIMIZATION_PROVIDER=openrouter
# AGENT_ME_OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
# AGENT_ME_OPENROUTER_KEY_FILE=/absolute/private/path/openrouter.key
